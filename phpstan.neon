includes:
    - phpstan-baseline.neon
    - vendor/cakedc/cakephp-phpstan/extension.neon

parameters:
    cakeDC:
        appNamespace: Crustum\Explorator
    level: 5
    paths:
        - src
    bootstrapFiles:
        - tests/bootstrap.php
    tmpDir: build/phpstan
    excludePaths:
        - src/TestSuite/ExploratorTrait.php

services:
